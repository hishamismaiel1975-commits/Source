

ASPNETCORE_ENVIRONMENT: Development

# Security settings
Security__SecretKey: "879b274c-9cab-4afa-a868-bf5d3038c8d7" # For production, use a secure key and store it in a secure location.
Security__Issuer: "ecommerce.identity"
Security__Audience: "ecommerce.clients"
Security__AccessTokenLifetimeInMinutes: 60    # 1 Hour
Security__RefreshTokenLifetimeInMinutes: 1440 # 24 hours

# Database connection strings for different databases used in the application
CatalogDb__ConnectionString: Server=sqlserver,1433;Database=CatalogDb;User Id=sa;Password=pass_123456789;TrustServerCertificate=True;
IdentityDb__ConnectionString: Server=sqlserver,1433;Database=IdentityDb;User Id=sa;Password=pass_123456789;TrustServerCertificate=True;


# Redis connection string for caching
RedisSettings__ConnectionString: redis:6379

# gRPC service URL 
GrpcSettings__DiscountUrl: http://discount-api:81

# HttpClient service URL 
HttpClient__DiscountUrl: http://discount-api:81

# Event bus connection string for RabbitMQ
EventBusSettings__HostAddress: amqp://admin:pass_123456789@rabbitmq:5672

# mongodb
MONGO_INITDB_ROOT_USERNAME: admin
MONGO_INITDB_ROOT_PASSWORD: pass_123456789

# sqlserver
MSSQL_SA_PASSWORD: pass_123456789

# postgres
POSTGRES_USER: admin
POSTGRES_PASSWORD: pass_123456789

rabbitmq:
RABBITMQ_DEFAULT_USER: admin
RABBITMQ_DEFAULT_PASS: pass_123456789


