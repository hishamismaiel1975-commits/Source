{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4000"
    ]

  },
    "ReverseProxy": {
      "Routes": {

        "identity-swagger": {
          "ClusterId": "identity",
          "Match": { "Path": "/api/identity/swagger/{**catch-all}" },
          "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
        },

        "identity": {
          "ClusterId": "identity",
          "Match": { "Path": "/api/identity/v1/{**catch-all}" },
          "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
        },


        "catalog-swagger": {
          "ClusterId": "catalog",
          "Match": { "Path": "/api/catalog/swagger/{**catch-all}" },
          "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
        },

        "catalog": {
          "ClusterId": "catalog",
          "Match": { "Path": "/api/catalog/v1/{**catch-all}" },
          "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
        }

      },
      "Clusters": {

        "identity": {
          "Destinations": {
            "identity-api": { "Address": "http://identity-api:80/" }
          }
        },

        "catalog": {
          "Destinations": { "catalog-api": { "Address": "http://catalog-api:80/" } }
        }
      }
    }
  }

