-- Install Helm
winget install Helm.Hel

kubectl create namespace ecommerce
kubectl delete namespace ecommerce

helm install ecommerce-infrastructure ./helm-infrastructure --namespace ecommerce 
helm upgrade ecommerce-infrastructure ./helm-infrastructure --namespace ecommerce

helm install ecommerce-apps ./helm-apps --namespace ecommerce 
helm upgrade ecommerce-apps ./helm-apps --namespace ecommerce

helm uninstall ecommerce-apps --namespace ecommerce 
helm uninstall ecommerce-infrastructure  --namespace ecommerce 

kubectl rollout restart deployment -n ecommerce

helm list -n ecommerce
helm lint ./helm-apps
helm template ecommerce ./helm > rendered.yaml
helm status ecommerce -n ecommerce
helm history ecommerce -n ecommerce
helm rollback ecommerce 0 -n ecommerce

-- Install Ingress Controller
helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx
helm repo update
helm upgrade --install ingress-nginx ingress-nginx/ingress-nginx --namespace ingress-nginx --create-namespace
helm repo list

-- Install Cert Manager
helm repo add jetstack https://charts.jetstack.io
helm repo update

kubectl create namespace cert-manager

helm install cert-manager jetstack/cert-manager --namespace cert-manager --version v1.18.2 --set crds.enabled=true


docker build --no-cache -t reporting-api:1.0.1 -f Services/Reporting/reporting.api/Dockerfile .

docker build --no-cache -t filestorage-api:1.0.0 -f Services/FileStorage/filestorage.api/Dockerfile .

docker build --no-cache -t gateway-api:1.0.1 -f Services/Gateway/gateway.api/Dockerfile .
docker build --no-cache -t catalog-api:1.0.1 -f Services/catalog/catalog.api/Dockerfile .

docker build --no-cache -t identity-api:1.0.0 -f Services/identity/identity.api/Dockerfile .
docker build --no-cache -t client:1.0.0 -f Dockerfile .

kubectl apply -R -f k8s
kubectl get all -n ecommerce
