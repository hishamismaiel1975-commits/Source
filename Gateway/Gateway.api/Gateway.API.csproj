    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>00bc8314-0444-47a2-9ff1-410212f6890a</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
