<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform\Platform.Lib.csproj" />
  </ItemGroup>


	<ItemGroup>
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.83.0" />
		<PackageReference Include="Google.Protobuf" Version="3.36.1" />
		<PackageReference Include="Grpc.Tools" Version="2.83.0">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Riok.Mapperly" Version="4.3.1" />
	</ItemGroup>
	
	<ItemGroup>
		<Protobuf Include="Infrastructure\Services\Identity\Proto\Identity.proto" GrpcServices="Client" />
		<Protobuf Include="Infrastructure\Services\Discount\Proto\discount.proto" GrpcServices="Client" />
	</ItemGroup>
	
	<ItemGroup>
	  <Folder Include="Core\DTOs\Discount\" />
	  <Folder Include="Core\DTOs\Identity\" />
	</ItemGroup>

</Project>
